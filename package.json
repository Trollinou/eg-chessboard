{
  "name": "eg-chessboard",
  "version": "1.7.3",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/eg-chessboard.css",
    "./base.css": "./dist/base.css",
    "./pieces/alpha.css": "./dist/pieces/alpha.css",
    "./pieces/cardinal.css": "./dist/pieces/cardinal.css",
    "./pieces/cburnett.css": "./dist/pieces/cburnett.css",
    "./pieces/dubrovny.css": "./dist/pieces/dubrovny.css",
    "./pieces/fantasy.css": "./dist/pieces/fantasy.css",
    "./pieces/firi.css": "./dist/pieces/firi.css",
    "./pieces/maestro.css": "./dist/pieces/maestro.css",
    "./pieces/merida.css": "./dist/pieces/merida.css",
    "./pieces/staunty.css": "./dist/pieces/staunty.css",
    "./pieces/tatiana.css": "./dist/pieces/tatiana.css",
    "./scss": {
      "sass": "./dist/scss/style.scss",
      "default": "./dist/scss/style.scss"
    },
    "./scss/*": "./dist/scss/*",
    "./vue": {
      "types": "./dist/vue/TheChessboard.vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react/Chessboard.d.ts",
      "import": "./dist/react.js"
    },
    "./stockfish.js": "./dist/stockfish.js",
    "./stockfish.wasm": "./dist/stockfish.wasm"
  },
  "style": "./dist/base.css",
  "sass": "./dist/scss/style.scss",
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:analyze": "cross-env ANALYZE=true vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src sandbox",
    "lint:fix": "eslint src sandbox --fix",
    "format": "prettier --write \"{src,sandbox,tests}/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "format:check": "prettier --check \"{src,sandbox,tests}/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "optimize-assets": "svgo -rf src/assets/pieces"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.2",
    "chessops": "^0.15.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.2",
    "sass-embedded": "^1.105.2",
    "stockfish": "^19.0.1",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "stockfish@19.0.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
