{
  "name": "eg-chessboard",
  "version": "1.7.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/index.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/eg-chessboard.css",
    "./base.css": "./dist/base.css",
    "./pieces/alpha.css": "./dist/pieces/alpha.css",
    "./pieces/cardinal.css": "./dist/pieces/cardinal.css",
    "./pieces/cburnett.css": "./dist/pieces/cburnett.css",
    "./pieces/dubrovny.css": "./dist/pieces/dubrovny.css",
    "./pieces/fantasy.css": "./dist/pieces/fantasy.css",
    "./pieces/firi.css": "./dist/pieces/firi.css",
    "./pieces/maestro.css": "./dist/pieces/maestro.css",
    "./pieces/merida.css": "./dist/pieces/merida.css",
    "./pieces/staunty.css": "./dist/pieces/staunty.css",
    "./pieces/tatiana.css": "./dist/pieces/tatiana.css",
    "./scss": {
      "sass": "./dist/scss/style.scss",
      "default": "./dist/scss/style.scss"
    },
    "./scss/*": "./dist/scss/*",
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue/TheChessboard.vue.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react/Chessboard.d.ts"
    }
  },
  "style": "./dist/eg-chessboard.css",
  "sass": "./dist/scss/style.scss",
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src sandbox",
    "lint:fix": "eslint src sandbox --fix",
    "format": "prettier --write \"{src,sandbox,tests}/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "format:check": "prettier --check \"{src,sandbox,tests}/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "optimize-assets": "svgo -rf src/assets/pieces"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.1",
    "chessops": "^0.15.1",
    "stockfish": "^18.0.8"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "sass-embedded": "^1.105.1",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "stockfish@18.0.8": true
  }
}