{
  "name": "eg-chessboard",
  "version": "1.1.4",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/eg-chessboard.css",
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue/TheChessboard.vue.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react/Chessboard.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "dev": "vite",
    "lint": "eslint src sandbox",
    "lint:fix": "eslint src sandbox --fix",
    "format": "prettier --write \"{src,sandbox}/**/*.{ts,tsx,vue,css,json,md}\"",
    "format:check": "prettier --check \"{src,sandbox}/**/*.{ts,tsx,vue,css,json,md}\""
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "stockfish": "^18.0.8"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
